# Orígenes extra permitidos para CORS (separados por coma). Los locales ya están permitidos.
# CORS_ORIGINS=https://valeur.app

# Alertas con la app cerrada: el backend las revisa cada ALERTS_EVERY segundos
# (mínimo 60) y deja la notificación en Supabase. La service role key está en
# Supabase → Project Settings → API. Es secreta: solo va acá, nunca en el front.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ALERTS_EVERY=180
